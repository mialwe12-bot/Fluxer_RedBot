# ─────────────────────────────────────────────────────────────
#  fluxer-redbot – Konfiguration
#  Kopieren nach .env und ausfüllen:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Basis-URL deiner Fluxer-Instanz (Web-App)
FLUXER_BASE_URL=https://chat.nebendahl.eu

# REST-API-Basis OHNE Version. Leer lassen = Discovery über
# ${FLUXER_BASE_URL}/.well-known/fluxer (endpoints.api_public), Fallback ${FLUXER_BASE_URL}/api.
# Ist der Wert gesetzt, hat er Vorrang (Abweichungen zur Discovery werden geloggt).
FLUXER_API_BASE_URL=https://chat.nebendahl.eu/api

# API-Version (wird als /v1 angehängt). Fluxer unterstützt derzeit nur Version 1.
FLUXER_API_VERSION=1

# Instanz-Discovery über /.well-known/fluxer verwenden (true/false)
FLUXER_DISCOVERY=true

# Bot-Token aus User Settings → Applications (Form: {application_id}.{secret})
FLUXER_TOKEN=

# Standard-Prefix (pro Server änderbar mit !prefix set …; Erwähnung des Bots geht immer)
BOT_PREFIX=!

# Bot-Owner (Fluxer-User-IDs, kommagetrennt). Der Owner der Application wird zusätzlich automatisch erkannt.
BOT_OWNER_IDS=

# Sprache der Bot-Texte (derzeit: de)
BOT_LOCALE=de

# Zeitzone für Scheduler, Tageszusammenfassungen usw.
TZ=Europe/Berlin

# Datenverzeichnis (SQLite, installierte Cogs, Repos). Im Docker-Container /data.
DATA_DIR=/data

# Logging: trace, debug, info, warn, error, fatal. LOG_PRETTY=true für lesbare Konsolen-Logs.
LOG_LEVEL=info
LOG_PRETTY=false

# Nach so vielen Sekunden ohne Gateway-Verbindung beendet sich der Bot (Docker startet neu).
WATCHDOG_SECONDS=600

# ── Phase 3: optionale API-Keys ─────────────────────────────
# streams: Twitch (kostenlos unter https://dev.twitch.tv/console → Anwendung registrieren)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# streams: YouTube-Livestreams (neue Videos gehen auch ohne Key über RSS)
YOUTUBE_API_KEY=
# image: Imgur-Suche und GIPHY-GIFs (Katzen/Hunde/Füchse gehen ohne Key)
IMGUR_CLIENT_ID=
GIPHY_API_KEY=
# instadl: Cookie-Datei (Netscape-Format) eines Instagram-Kontos, wenn Instagram eine Anmeldung verlangt.
# Datei z. B. nach ./secrets/instagram-cookies.txt legen und im docker-compose einbinden.
INSTAGRAM_COOKIES=
# Upload-Limit der Instanz in MB (Annahme: 25)
UPLOAD_LIMIT_MB=25
# Pfad zu yt-dlp (im Docker-Image vorhanden)
YTDLP_PATH=yt-dlp

# ── Ab Phase 4 (noch nicht benötigt) ────────────────────────
# TMDB_API_KEY=                 # animewatch: Serien/Filme
# UNTIS_ENCRYPTION_KEY=         # untis: 32 Byte als Hex/Base64 (AES-256-GCM)
# JELLYFIN_URL=https://jellyfin.mrcoolgamer.de
# JELLYFIN_API_KEY=
