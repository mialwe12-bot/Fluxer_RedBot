{
  "name": "fluxer-redbot",
  "version": "0.1.0",
  "description": "Modularer Fluxer-Bot im Stil von Red-DiscordBot: schlanker Kern, Cogs zur Laufzeit ladbar.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "healthcheck": "node dist/healthcheck.js"
  },
  "dependencies": {
    "@fluxerjs/rest": "3.1.0",
    "@fluxerjs/types": "3.3.0",
    "@fluxerjs/ws": "3.1.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
